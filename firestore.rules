rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if request.auth != null;
      // Users can only write/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false; // Restrict making someone an admin manually via admin dashboard
    }
    
    match /items/{itemId} {
      // Authenticated users can read all items
      allow read: if request.auth != null;
      // Authenticated users can create items
      allow create: if request.auth != null;
      // Users can update their own reported items OR Admins can update any item
      // OR any authenticated user can update status to Resolved (for chat resolution)
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.user_id || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         (request.resource.data.status == 'Resolved' && resource.data.status == 'Reserved'));
      // Only Admins can delete items OR the user who created it
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.user_id || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    match /claims/{claimId} {
      // Authenticated users can read claims
      allow read: if request.auth != null;
      // Authenticated users can create claims
      allow create: if request.auth != null;
      // Only claimant, item owner, or Admin can update a claim
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.claimant_id || 
         request.auth.uid == resource.data.owner_id || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    match /chat_rooms/{roomId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}
